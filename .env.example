# Copy to .env (git-ignored) and fill in on each machine. Plain environment variables work too.

# ---- general
FM_DEVICE=auto              # auto | cpu | cuda | cuda:0
FM_PRECISION=auto           # auto | fp32 | bf16 | fp16 (see baselines/fm_models.py); use bf16 when memory-bound
FM_MAX_CONTEXT=0            # cap on training rows given to an FM (stratified subsample); 0 = no cap
FM_CPU_THREADS=4            # torch threads when a model runs on the CPU (keep <= 4 per process)
# CUDA_VISIBLE_DEVICES=0

# ---- TabPFN-3.5 (Prior Labs; weights under the non-commercial TABPFN-3.5 License v1.0)
# Empty TABPFN_MODEL_PATH -> the checkpoint is downloaded once from Hugging Face (Prior-Labs/tabpfn_3_5, pinned commit,
# public) into TABPFN_MODEL_CACHE_DIR; afterwards HF_HUB_OFFLINE=1 runs offline.
TABPFN_MODEL_PATH=          # optional local checkpoint, e.g. /models/tabpfn/tabpfn-v3.5-20260909.safetensors
TABPFN_MODEL_VERSION=v3.5   # v3.5 | v3.5-fast (Hugging Face); v3 | v2.5 -> tabpfn's own download (needs TABPFN_TOKEN)
# TABPFN_HF_REPO=Prior-Labs/tabpfn_3_5
# TABPFN_HF_REVISION=06bf2ba35c80a92a3b9abb436b99cf49e7a0365e
# TABPFN_HF_FILE=           # overrides the file chosen by TABPFN_MODEL_VERSION
TABPFN_MODEL_CACHE_DIR=     # default <HF_HOME>/tabpfn/<commit>, e.g. /models/tabpfn
TABPFN_TOKEN=               # tabpfn's own download only
TABPFN_NO_BROWSER=1
TABPFN_N_ESTIMATORS=8
# TABPFN_ALLOW_CPU_LARGE_DATASET=true

# ---- TabICLv2 (open weights, HF repo jingang/TabICL)
TABICL_MODEL_PATH=          # e.g. /models/tabicl/tabicl-classifier-v2-20260212.ckpt ; empty = HF download
TABICL_CHECKPOINT_VERSION=tabicl-classifier-v2-20260212.ckpt
TABICL_N_ESTIMATORS=8
TABICL_BATCH_SIZE=8         # lower if GPU/CPU memory is tight

# ---- NVIDIA Kumo-Tabular (structured-data-models; HF repo nvidia/Kumo-Tabular rev v1.0.1)
KUMO_SIZE=large             # small | medium | large
KUMO_CHECKPOINT_DIR=        # optional dir containing <size>/classifier.pt or classifier.pt ; empty = HF cache/download
KUMO_N_ESTIMATORS=8

# ---- Hugging Face cache (all three models when no local path is set). Point at pre-downloaded weights and go offline if needed.
# HF_HOME=/models/hf
# HF_HUB_CACHE=/models/hf/hub
# HF_HUB_OFFLINE=1
# HF_TOKEN=
